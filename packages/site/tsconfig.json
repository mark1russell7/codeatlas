{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@mark1russell7/cue/ts/config/node.json",
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "isolatedDeclarations": false
  },
  "include": ["src/**/*"]
}
