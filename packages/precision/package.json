{
  "$schema": "https://json.schemastore.org/package",
  "name": "@codeatlas/precision",
  "description": "The precision checks of the dimensions of the atlas, against independent tools.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "bin": {
    "codeatlas-precision": "./src/cli.ts"
  },
  "dependencies": {
    "@mark1russell7/codeatlas": "workspace:*",
    "@mark1russell7/rigor-generators": "^0.1.6",
    "@mark1russell7/rigor-statistics": "^0.1.17",
    "eslint": "^10.14.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.1.1",
    "@types/node": "^26.6.5",
    "vitest": "^5.0.3"
  }
}
